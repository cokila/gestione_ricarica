[Desktop Entry]
Version=1.0
Type=Application
Name=Gestione ricarica
Comment=Ricarica 80% o 100%, prestazioni e autonomia con CPU adattiva, budget Intel e misure dei consumi
Exec=/usr/bin/python3 /home/mac/.local/share/macbook-charge/charge-manager.py
Icon=battery
Terminal=true
Categories=Settings;HardwareSettings;
StartupNotify=false
